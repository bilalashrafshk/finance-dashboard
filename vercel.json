{
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "app/api/**/*.ts": {
      "memory": 512,
      "maxDuration": 60
    },
    "app/api/**/*.tsx": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/screener/update",
      "schedule": "*/5 4-12 * * 1-5"
    },
    {
      "path": "/api/events/process",
      "schedule": "*/5 4-12 * * 1-5"
    },
    {
      "path": "/api/events/discovery",
      "schedule": "*/5 4-12 * * 1-5"
    },
    {
      "path": "/api/sbp/macros/update",
      "schedule": "*/5 4-12 * * 1-5"
    },
    {
      "path": "/api/financials/update",
      "schedule": "*/15 4-12 * * 1-5"
    }
  ]
}
